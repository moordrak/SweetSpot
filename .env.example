# Kopirajte u .env i upišite vlastitu dugu nasumičnu lozinku.
# Ista vrijednost ide u agent/config.ini (token) i služi kao lozinka za web sučelje.
API_TOKEN=promijenite-ovu-lozinku

# Neobavezno: Google klijent za kopiju na Google Drive (vrsta "TVs and Limited Input devices").
# Može se upisati i u postavkama web sučelja.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
